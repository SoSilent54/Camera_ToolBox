[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.arm64 = "res://target/debug/libpongbot_calib_tool.so"
linux.release.arm64 = "res://target/release/libpongbot_calib_tool.so"
linux.debug.x86_64 = "res://target/debug/libpongbot_calib_tool.so"
linux.release.x86_64 = "res://target/release/libpongbot_calib_tool.so"
windows.debug.x86_64 = "res://target/debug/pongbot_calib_tool.dll"
windows.release.x86_64 = "res://target/release/pongbot_calib_tool.dll"
